# Syntegra application image — RHEL 10 UBI, Python 3.12 (MFS §16 binding stack).
# Build:  podman build -f deploy/Containerfile -t syntegra:$(git rev-parse --short HEAD) .
FROM registry.access.redhat.com/ubi10/python-312-minimal AS build
USER 0
RUN microdnf install -y gcc mariadb-connector-c-devel pkgconf-pkg-config && microdnf clean all
WORKDIR /opt/app-root/src
COPY pyproject.toml README.md ./
COPY src ./src
RUN python -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
 && /opt/venv/bin/pip install --no-cache-dir . && /opt/venv/bin/pip uninstall -y syntegra  # dependencies only

FROM registry.access.redhat.com/ubi10/python-312-minimal
USER 0
RUN microdnf install -y mariadb-connector-c && microdnf clean all
# OCR for scanned documents (CR-007, FR-DOC-203): Tesseract with English and poppler-utils (pdftoppm, to rasterise
# image-only PDFs). Tesseract is not in the UBI repositories, so it comes from EPEL 10, signature-checked.
RUN printf '%s\n' '[epel]' 'name=Extra Packages for Enterprise Linux 10 - $basearch' \
      'baseurl=https://dl.fedoraproject.org/pub/epel/10/Everything/$basearch/' 'enabled=1' 'gpgcheck=1' \
      'gpgkey=https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-10' > /etc/yum.repos.d/epel.repo \
 && microdnf install -y --setopt=install_weak_deps=0 tesseract poppler-utils \
 && { rpm -q tesseract-langpack-eng >/dev/null || microdnf install -y --setopt=install_weak_deps=0 tesseract-langpack-eng; } \
 && microdnf clean all \
 && tesseract --version && pdftoppm -v && tesseract --list-langs 2>&1 | grep -qx eng
COPY --from=build /opt/venv /opt/venv
WORKDIR /opt/app-root/src
# The CEDA DDL is the physical schema authority applied by `manage.py migrate --database=<zone>`.
COPY ceda/generated/mysql ./ceda/generated/mysql
COPY ceda/releases ./ceda/releases
COPY manage.py ./
COPY src ./src
ENV PATH=/opt/venv/bin:$PATH PYTHONPATH=/opt/app-root/src/src \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=syntegra.settings.prod \
    SYNTEGRA_CEDA_DDL_DIR=/opt/app-root/src/ceda/generated/mysql \
    SYNTEGRA_CEDA_RELEASES_DIR=/opt/app-root/src/ceda/releases
RUN python manage.py collectstatic --noinput --settings=syntegra.settings.dev >/dev/null
# Document scans (CR-007) are the only copy of each master: they live on a mounted volume, not in the image.
RUN mkdir -p /var/lib/syntegra/objects && chown 1001:0 /var/lib/syntegra/objects && chmod 0770 /var/lib/syntegra/objects
ENV SYNTEGRA_OBJECT_STORE_DIR=/var/lib/syntegra/objects
VOLUME ["/var/lib/syntegra/objects"]
USER 1001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s CMD python -c "import urllib.request,sys; urllib.request.urlopen('http://127.0.0.1:8000/healthz'); sys.exit(0)"
CMD ["gunicorn", "syntegra.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "4", "--threads", "4", \
     "--worker-class", "gthread", "--access-logfile", "-", "--max-requests", "5000", "--max-requests-jitter", "500"]
