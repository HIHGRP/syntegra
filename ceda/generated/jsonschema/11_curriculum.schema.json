    "DeliveryLog": {
      "title": "DeliveryLog",
      "description": "Evidence that a lesson was delivered — objectives covered, learners present, note (G6)",
      "type": "object",
      "x-ceda": {
        "entity": "delivery_log",
        "zone": "ops",
        "domain": "CUR",
        "kind": "event",
        "classification": "internal",
        "history": "append",
        "module": "curriculum"
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Primary key: UUID v7 (time-ordered) stored as BINARY(16) without byte swap",
          "readOnly": true
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning tenant (zones with tenant_column = true)",
          "readOnly": true
        },
        "scope_node_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning governance scope node (entities with scope: owned); subtree visibility through scope_closure",
          "readOnly": true
        },
        "lesson_occurrence_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "lesson_occurrence"
        },
        "teaching_assignment_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "teaching_assignment"
        },
        "staff_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "staff"
        },
        "node_ids": {
          "type": "object",
          "description": "Objectives covered"
        },
        "delivered_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "is_as_planned": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "enum": [
            "class_page",
            "staff_app",
            "lms_lesson",
            "import"
          ],
          "description": "class_page, staff_app, lms_lesson"
        },
        "learners_present": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
