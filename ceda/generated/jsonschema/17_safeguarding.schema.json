        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "author_user_id": {
          "type": "string",
          "format": "uuid"
        },
        "body": {
          "type": "string",
          "x-classification": "special",
          "writeOnly": true
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "object",
              "description": "Linked concern, attendance or behaviour record the DSL may see"
            },
            {
              "type": "null"
            }
          ]
        },
        "document_ids": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time the row was written",
          "readOnly": true
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor: app_user.id or service_identity.id (agents, integrations)",
