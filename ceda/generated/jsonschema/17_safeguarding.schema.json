{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.syntegra.io/ceda/v1/17_safeguarding.schema.json",
  "title": "CEDA SAF — Safeguarding — concerns, cases, chronologies, referrals, secure sharing, allegations about adults and community reporting",
  "$defs": {
    "SafeguardingConcern": {
      "title": "SafeguardingConcern",
      "description": "Concern recorded by any adult (the reporter sees only a receipt afterwards)",
      "type": "object",
      "x-ceda": {
        "entity": "safeguarding_concern",
        "zone": "vault",
        "domain": "SAF",
        "kind": "event",
        "classification": "special",
        "history": "append",
        "module": "safeguarding"
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Primary key: UUID v7 (time-ordered) stored as BINARY(16) without byte swap",
          "readOnly": true
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning tenant (zones with tenant_column = true)",
          "readOnly": true
        },
        "scope_node_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning governance scope node (entities with scope: owned); subtree visibility through scope_closure",
          "readOnly": true
        },
        "learner_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "learner"
        },
        "case_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "x-ref": "safeguarding_case",
              "description": "Linked on triage"
            },
            {
              "type": "null"
            }
          ]
        },
        "category": {
          "type": "string",
          "maxLength": 32,
          "x-code-list": "concern_category",
          "description": "From the jurisdiction pack (Nigerian default)"
        },
        "reported_by": {
          "type": "string",
          "format": "uuid"
        },
        "source": {
          "type": "string",
          "enum": [
            "staff",
            "learner",
            "parent",
            "community_report",
            "wellbeing_keyword",
            "agency"
          ]
        },
        "body": {
          "type": "string",
          "x-classification": "special",
          "writeOnly": true,
          "description": "What was seen or heard (encrypted, per-record key)"
        },
        "body_map": {
          "anyOf": [
            {
              "type": "object",
              "description": "Body-map annotations (no free text)"
            },
            {
              "type": "null"
            }
          ]
        },
        "occurred_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt_code": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[A-Za-z0-9_.:/-]*$",
          "description": "Shown to the reporter"
        },
        "community_report_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "x-ref": "community_report"
            },
            {
              "type": "null"
            }
          ]
        },
        "wellbeing_concern_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "x-ref": "wellbeing_concern"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time the row was written",
          "readOnly": true
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor: app_user.id or service_identity.id (agents, integrations)",
          "readOnly": true
        }
      },
      "required": [
        "id",
        "tenant_id",
        "scope_node_id",
        "learner_id",
        "category",
        "reported_by",
        "source",
        "body",
        "receipt_code",
        "created_at"
      ],
      "additionalProperties": false
    },
    "SafeguardingCase": {
      "title": "SafeguardingCase",
      "description": "Safeguarding 360 case (risk assessment, actions, referrals, meetings, reviews, closure with sign-off)",
      "type": "object",
      "x-ceda": {
        "entity": "safeguarding_case",
        "zone": "vault",
        "domain": "SAF",
        "kind": "master",
        "classification": "special",
        "history": "lifecycle",
        "module": "safeguarding"
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Primary key: UUID v7 (time-ordered) stored as BINARY(16) without byte swap",
          "readOnly": true
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning tenant (zones with tenant_column = true)",
          "readOnly": true
        },
        "scope_node_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning governance scope node (entities with scope: owned); subtree visibility through scope_closure",
          "readOnly": true
        },
        "case_reference": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^[A-Za-z0-9_.:/-]*$",
          "description": "SG-YYYY-NNNN"
        },
        "learner_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "learner"
        },
        "dsl_user_id": {
          "type": "string",
          "format": "uuid"
        },
        "risk_level": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 32,
              "x-code-list": "risk_level",
              "description": "Set by the DSL only"
            },
            {
              "type": "null"
            }
          ]
        },
        "opened_at": {
          "type": "string",
          "format": "date-time"
        },
        "review_due_on": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "closure_reason": {
          "anyOf": [
            {
              "type": "string",
              "x-classification": "special",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ]
        },
        "closed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "closed_signed_by": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "transferred_to_institution_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "description": "DSL-to-DSL transfer"
            },
            {
              "type": "null"
            }
          ]
        },
        "transfer_acknowledged_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "in_progress",
            "on_hold",
            "closed",
            "transferred"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time the row was written",
          "readOnly": true
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor: app_user.id or service_identity.id (agents, integrations)",
          "readOnly": true
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time of last change (mutable entities only)",
          "readOnly": true
        },
        "updated_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor of last change (mutable entities only)",
          "readOnly": true
        },
        "row_version": {
          "type": "integer",
          "minimum": 0,
          "description": "Optimistic-lock counter; exposed as the API ETag (mutable entities only)",
          "readOnly": true
        }
      },
      "required": [
        "id",
        "tenant_id",
        "scope_node_id",
        "case_reference",
        "learner_id",
        "dsl_user_id",
        "opened_at",
        "status",
        "created_at",
        "updated_at",
        "row_version"
      ],
      "additionalProperties": false
    },
    "SafeguardingEntry": {
      "title": "SafeguardingEntry",
      "description": "Chronology entry — concern, action, decision, agency contact, meeting, review (encrypted text, append-only)",
      "type": "object",
