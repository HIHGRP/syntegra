          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision_reason": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 65535
            },
            {
              "type": "null"
            }
          ]
        },
        "amount_approved_minor": {
          "anyOf": [
            {
              "type": "integer",
              "description": "(minor units)"
            },
            {
              "type": "null"
            }
          ]
