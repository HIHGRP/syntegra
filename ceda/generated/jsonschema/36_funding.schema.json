              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "recommendation": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 65535
            },
            {
              "type": "null"
            }
          ]
        },
        "decided_by": {
          "anyOf": [
