{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.syntegra.io/ceda/v1/36_funding.schema.json",
  "title": "CEDA FND — Funding and loan platforms — capital for institutions, staff welfare and student support",
  "$defs": {
    "FundingProgramme": {
      "title": "FundingProgramme",
      "description": "Funding or loan programme — provider, beneficiary, purpose, instrument, terms and eligibility",
      "type": "object",
      "x-ceda": {
        "entity": "funding_programme",
        "zone": "ops",
        "domain": "FND",
        "kind": "config",
        "classification": "internal",
        "history": "lifecycle",
        "module": "funding"
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Primary key: UUID v7 (time-ordered) stored as BINARY(16) without byte swap",
          "readOnly": true
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning tenant (zones with tenant_column = true)",
          "readOnly": true
        },
        "scope_node_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning governance scope node (entities with scope: owned); subtree visibility through scope_closure",
          "readOnly": true
        },
        "code": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9_.:/-]*$"
        },
        "name": {
          "type": "string",
          "maxLength": 300
        },
        "provider_name": {
          "type": "string",
          "maxLength": 200
        },
        "provider_kind": {
          "type": "string",
          "enum": [
            "federal_government_agency",
            "state_government",
            "local_government",
            "development_partner",
            "bank",
            "microfinance",
            "cooperative",
            "employer",
            "institution",
            "alumni",
            "philanthropy",
            "other"
          ]
        },
        "provider_body_code": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 16,
              "pattern": "^[A-Za-z0-9_.:/-]*$",
              "description": "Education body in the regulators' directory, e.g. TETFUND, UBEC, NELFUND"
            },
            {
              "type": "null"
            }
          ]
        },
        "beneficiary_kind": {
          "type": "string",
          "enum": [
            "institution",
            "staff",
            "learner"
          ]
        },
        "purpose": {
          "type": "string",
          "enum": [
            "capital_works",
            "equipment",
            "ict",
            "research",
            "staff_development",
            "operations",
            "tuition_fees",
            "upkeep",
            "housing",
            "vehicle",
            "welfare_emergency",
            "salary_advance",
            "scholarship",
            "bursary",
            "special_needs",
            "other"
          ]
        },
        "instrument": {
          "type": "string",
          "enum": [
            "loan",
            "grant",
            "scholarship",
            "bursary",
            "intervention",
            "matching_grant",
            "salary_advance",
            "bond",
            "guarantee",
            "in_kind"
          ]
        },
        "interest_rate": {
          "type": "string",
          "format": "decimal",
          "description": "Annual nominal rate; 0 for interest-free loans and for grants"
        },
        "tenor_months": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "moratorium_months": {
          "type": "integer"
        },
        "repayment_basis": {
          "type": "string",
          "enum": [
            "none",
            "fixed_instalment",
            "annuity",
            "income_contingent",
            "payroll_deduction",
            "bullet"
          ]
        },
        "max_amount_minor": {
          "anyOf": [
            {
              "type": "integer",
              "description": "(minor units)"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "eligibility": {
          "anyOf": [
            {
              "type": "object",
              "description": "Rules: beneficiary levels, ownership, category, minimum service years, maximum income, matching contribution …"
            },
            {
              "type": "null"
            }
          ]
        },
        "terms": {
          "anyOf": [
            {
              "type": "object",
              "description": "Further terms as published (e.g. repayment as a share of salary after national service)"
            },
            {
              "type": "null"
            }
          ]
        },
        "opens_on": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "closes_on": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "data_status": {
          "type": "string",
          "enum": [
            "verified",
            "illustrative",
            "to_confirm"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "approved",
            "published",
            "superseded",
            "retired",
            "withdrawn"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time the row was written",
          "readOnly": true
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor: app_user.id or service_identity.id (agents, integrations)",
          "readOnly": true
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time of last change (mutable entities only)",
          "readOnly": true
        },
        "updated_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor of last change (mutable entities only)",
          "readOnly": true
        },
        "row_version": {
          "type": "integer",
          "minimum": 0,
          "description": "Optimistic-lock counter; exposed as the API ETag (mutable entities only)",
          "readOnly": true
        }
      },
      "required": [
        "id",
        "tenant_id",
        "scope_node_id",
        "code",
        "name",
        "provider_name",
        "provider_kind",
        "beneficiary_kind",
        "purpose",
        "instrument",
        "interest_rate",
        "moratorium_months",
        "repayment_basis",
        "currency",
        "data_status",
        "status",
        "created_at",
        "updated_at",
        "row_version"
      ],
      "additionalProperties": false
    },
    "FundingApplication": {
      "title": "FundingApplication",
      "description": "Application to a funding programme by or for an institution, a member of staff or a learner",
      "type": "object",
      "x-ceda": {
        "entity": "funding_application",
        "zone": "ops",
        "domain": "FND",
