{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.syntegra.io/ceda/v1/34_federal_institutions.schema.json",
  "title": "CEDA FED — Federal unity colleges and federal special training institutions — owning bodies, their structures, institutions",
  "$defs": {
    "FederalBody": {
      "title": "FederalBody",
      "description": "Federal ministry, department, parastatal or commission that owns or supervises federal institutions",
      "type": "object",
      "x-ceda": {
        "entity": "federal_body",
        "zone": "registry",
        "domain": "FED",
        "kind": "master",
        "classification": "internal",
        "history": "lifecycle",
        "module": "federal_institutions"
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Primary key: UUID v7 (time-ordered) stored as BINARY(16) without byte swap",
          "readOnly": true
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning tenant (zones with tenant_column = true)",
          "readOnly": true
        },
        "scope_node_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning governance scope node (entities with scope: owned); subtree visibility through scope_closure",
          "readOnly": true
        },
        "code": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[A-Za-z0-9_.:/-]*$",
          "description": "e.g. FME, FMAFS, FMOH, FMAV, FMT"
        },
        "name": {
          "type": "string",
          "maxLength": 300
        },
        "category": {
          "type": "string",
          "enum": [
            "ministry",
            "department",
            "parastatal",
            "commission",
            "agency"
          ]
        },
        "parent_body_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "x-ref": "federal_body",
              "description": "e.g. a parastatal's supervising ministry"
            },
            {
              "type": "null"
            }
          ]
        },
        "website": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "data_status": {
          "type": "string",
          "enum": [
            "verified",
            "illustrative",
            "to_confirm"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "inactive",
            "retired"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time the row was written",
          "readOnly": true
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor: app_user.id or service_identity.id (agents, integrations)",
          "readOnly": true
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time of last change (mutable entities only)",
          "readOnly": true
        },
        "updated_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor of last change (mutable entities only)",
          "readOnly": true
        },
        "row_version": {
          "type": "integer",
          "minimum": 0,
          "description": "Optimistic-lock counter; exposed as the API ETag (mutable entities only)",
          "readOnly": true
        }
      },
      "required": [
        "id",
        "tenant_id",
        "scope_node_id",
        "code",
        "name",
        "category",
        "data_status",
        "status",
        "created_at",
        "updated_at",
        "row_version"
      ],
      "additionalProperties": false
    },
    "FederalBodyUnit": {
      "title": "FederalBodyUnit",
      "description": "Unit of a federal body's own structure (department, directorate, division, geopolitical zone)",
      "type": "object",
      "x-ceda": {
        "entity": "federal_body_unit",
        "zone": "registry",
        "domain": "FED",
        "kind": "master",
        "classification": "internal",
        "history": "lifecycle",
        "module": "federal_institutions"
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Primary key: UUID v7 (time-ordered) stored as BINARY(16) without byte swap",
          "readOnly": true
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning tenant (zones with tenant_column = true)",
          "readOnly": true
        },
        "scope_node_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning governance scope node (entities with scope: owned); subtree visibility through scope_closure",
          "readOnly": true
        },
        "body_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "federal_body"
        },
        "parent_unit_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "x-ref": "federal_body_unit"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit_type": {
          "type": "string",
          "enum": [
            "department",
            "directorate",
            "division",
            "unit",
            "zone"
          ]
        },
        "code": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[A-Za-z0-9_.:/-]*$",
          "description": "Unique within the body"
        },
        "name": {
          "type": "string",
          "maxLength": 300
        },
        "data_status": {
          "type": "string",
          "enum": [
            "verified",
            "illustrative",
            "to_confirm"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "inactive",
            "retired"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time the row was written",
          "readOnly": true
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor: app_user.id or service_identity.id (agents, integrations)",
          "readOnly": true
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time of last change (mutable entities only)",
          "readOnly": true
        },
        "updated_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor of last change (mutable entities only)",
          "readOnly": true
        },
        "row_version": {
          "type": "integer",
          "minimum": 0,
          "description": "Optimistic-lock counter; exposed as the API ETag (mutable entities only)",
          "readOnly": true
        }
      },
      "required": [
        "id",
        "tenant_id",
        "scope_node_id",
        "body_id",
        "unit_type",
        "code",
        "name",
        "data_status",
        "status",
        "created_at",
        "updated_at",
        "row_version"
      ],
      "additionalProperties": false
    },
    "FederalInstitution": {
      "title": "FederalInstitution",
      "description": "Federal profile of a unity college or federal special training institution",
      "type": "object",
      "x-ceda": {
        "entity": "federal_institution",
        "zone": "registry",
        "domain": "FED",
        "kind": "master",
        "classification": "internal",
        "history": "lifecycle",
        "module": "federal_institutions"
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Primary key: UUID v7 (time-ordered) stored as BINARY(16) without byte swap",
          "readOnly": true
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning tenant (zones with tenant_column = true)",
          "readOnly": true
        },
        "scope_node_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning governance scope node (entities with scope: owned); subtree visibility through scope_closure",
          "readOnly": true
        },
        "institution_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "institution"
        },
        "body_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "federal_body"
        },
        "unit_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "federal_body_unit"
        },
        "institution_type": {
          "type": "string",
          "enum": [
            "unity_college",
            "unity_college_girls",
            "unity_college_boys",
            "science_technical_college",
            "special_needs_college",
            "college_of_education",
            "college_of_education_technical",
            "college_of_education_special",
            "college_of_agriculture",
            "college_of_forestry",
            "college_of_fisheries",
            "college_of_animal_health",
            "college_of_land_resources",
            "college_of_veterinary_laboratory",
            "cooperative_college",
            "school_of_statistics",
            "school_of_surveying",
            "aviation_college",
            "maritime_academy",
            "petroleum_training_institute",
            "policy_institute",
            "teacher_training_institute",
            "other_special"
          ]
        },
        "geopolitical_zone": {
          "type": "string",
          "enum": [
            "north_central",
            "north_east",
            "north_west",
            "south_east",
            "south_south",
            "south_west"
          ]
        },
        "gender_intake": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "mixed",
                "boys",
                "girls"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "day_boarding": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "day",
                "boarding",
                "mixed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "admission_basis": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "national_common_entrance",
                "utme",
                "direct_entry",
                "merit_and_quota",
                "agency_recruitment",
                "other"
              ],
              "description": "e.g. national_common_entrance for unity colleges"
            },
            {
              "type": "null"
            }
          ]
        },
        "established_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "data_status": {
          "type": "string",
          "enum": [
            "verified",
            "illustrative",
            "to_confirm"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time the row was written",
          "readOnly": true
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor: app_user.id or service_identity.id (agents, integrations)",
          "readOnly": true
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time of last change (mutable entities only)",
          "readOnly": true
        },
        "updated_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor of last change (mutable entities only)",
          "readOnly": true
        },
        "row_version": {
          "type": "integer",
          "minimum": 0,
          "description": "Optimistic-lock counter; exposed as the API ETag (mutable entities only)",
          "readOnly": true
        }
      },
      "required": [
        "id",
        "tenant_id",
        "scope_node_id",
        "institution_id",
        "body_id",
        "unit_id",
        "institution_type",
        "geopolitical_zone",
        "data_status",
        "created_at",
        "updated_at",
        "row_version"
      ],
      "additionalProperties": false
    }
  }
}
