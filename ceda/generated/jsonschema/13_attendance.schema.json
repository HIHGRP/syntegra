    "EvacuationEvent": {
      "title": "EvacuationEvent",
      "description": "Evacuation or drill (start, all-clear, timings as safe-schools inspection evidence)",
      "type": "object",
      "x-ceda": {
        "entity": "evacuation_event",
        "zone": "ops",
        "domain": "ATT",
        "kind": "transaction",
        "classification": "internal",
        "history": "lifecycle",
        "module": "attendance"
      },
      "properties": {
        "id": {
