        "entity": "staff_attendance",
        "zone": "ops",
        "domain": "ATT",
        "kind": "event",
        "classification": "confidential",
        "history": "append",
        "module": "attendance"
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
