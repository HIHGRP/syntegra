          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "enum": [
            "teacher",
            "office",
            "kiosk",
            "biometric_device",
            "lms_live_class",
            "parent_prefill",
            "import"
          ]
        },
        "device_ref": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_.:/-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time the row was written",
          "readOnly": true
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor: app_user.id or service_identity.id (agents, integrations)",
          "readOnly": true
        }
      },
      "required": [
        "id",
        "tenant_id",
        "scope_node_id",
        "staff_id",
        "signed_on",
        "direction",
        "at",
        "source",
        "created_at"
      ],
      "additionalProperties": false
    },
