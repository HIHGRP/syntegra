    "ConsentRecord": {
      "title": "ConsentRecord",
      "description": "Consent given or refused by a guardian (or learner of age) for a learner — the consent record",
      "type": "object",
      "x-ceda": {
        "entity": "consent_record",
        "zone": "ops",
        "domain": "FAM",
        "kind": "transaction",
        "classification": "confidential",
        "history": "effective",
        "module": "families"
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Primary key: UUID v7 (time-ordered) stored as BINARY(16) without byte swap",
          "readOnly": true
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning tenant (zones with tenant_column = true)",
          "readOnly": true
        },
        "learner_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "learner"
        },
        "guardian_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "x-ref": "guardian",
              "description": "NULL when the learner gives consent themselves"
            },
            {
              "type": "null"
            }
          ]
        },
        "consent_type": {
          "type": "string",
          "maxLength": 32,
          "x-code-list": "consent_type",
          "description": "photography, trips, data_sharing, medical, biometrics, digital_services, video_recording …"
        },
        "consent_request_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "x-ref": "consent_request"
            },
            {
              "type": "null"
            }
          ]
        },
        "request_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "description": "Version of the request answered"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "given",
            "refused",
            "withdrawn"
          ]
        },
        "legal_basis": {
          "type": "string",
          "enum": [
            "consent",
            "contract",
            "legal_obligation",
            "vital_interests",
            "public_task",
            "legitimate_interests"
          ]
        },
        "channel": {
          "type": "string",
          "enum": [
            "in_app",
            "push",
            "sms",
            "whatsapp",
            "email",
            "voice",
            "ussd",
            "workspace",
            "web",
