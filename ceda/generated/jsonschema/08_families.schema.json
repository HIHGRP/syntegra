{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.syntegra.io/ceda/v1/08_families.schema.json",
  "title": "CEDA FAM — Family 360, guardians, contacts, contact restrictions and consent",
  "$defs": {
    "Guardian": {
      "title": "Guardian",
      "description": "Parent/Guardian 360 master",
      "type": "object",
      "x-ceda": {
        "entity": "guardian",
        "zone": "registry",
        "domain": "FAM",
        "kind": "master",
        "classification": "confidential",
        "history": "lifecycle",
        "module": "families"
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Primary key: UUID v7 (time-ordered) stored as BINARY(16) without byte swap",
          "readOnly": true
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning tenant (zones with tenant_column = true)",
          "readOnly": true
        },
        "given_name": {
          "type": "string",
          "maxLength": 200,
          "x-personal-data": true
        },
        "family_name": {
          "type": "string",
          "maxLength": 200,
          "x-personal-data": true
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 30
            },
            {
              "type": "null"
            }
          ]
        },
        "name_phonetic": {
          "type": "string",
          "maxLength": 120
        },
        "phone": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\+[1-9][0-9]{6,14}$",
              "description": "E.164; inbound WhatsApp matching uses phone_hmac in channel contacts",
              "x-personal-data": true
            },
            {
              "type": "null"
            }
          ]
        },
        "email": {
          "anyOf": [
            {
              "type": "string",
              "format": "email",
              "maxLength": 254,
              "x-personal-data": true
            },
            {
              "type": "null"
            }
          ]
        },
        "preferred_language": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 35
            },
            {
              "type": "null"
            }
          ]
        },
        "preferred_channel": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "in_app",
                "push",
                "sms",
                "whatsapp",
                "email",
                "voice",
                "ussd",
                "workspace",
                "web",
                "post"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "address": {
          "anyOf": [
            {
              "type": "object",
              "x-personal-data": true
            },
            {
              "type": "null"
            }
          ]
        },
        "user_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "x-ref": "app_user",
              "description": "Parent portal account"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "inactive",
            "merged",
            "deceased"
          ]
        },
        "merged_into": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "x-ref": "guardian"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time the row was written",
          "readOnly": true
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor: app_user.id or service_identity.id (agents, integrations)",
          "readOnly": true
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time of last change (mutable entities only)",
          "readOnly": true
        },
        "updated_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor of last change (mutable entities only)",
          "readOnly": true
        },
        "row_version": {
          "type": "integer",
          "minimum": 0,
          "description": "Optimistic-lock counter; exposed as the API ETag (mutable entities only)",
          "readOnly": true
        }
      },
      "required": [
        "id",
        "tenant_id",
        "given_name",
        "family_name",
        "name_phonetic",
        "status",
        "created_at",
        "updated_at",
        "row_version"
      ],
      "additionalProperties": false
    },
    "LearnerGuardian": {
      "title": "LearnerGuardian",
      "description": "Relationship between a learner and a guardian (parental responsibility, priority, lives-with, restriction flag)",
      "type": "object",
