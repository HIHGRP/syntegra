          "x-ref": "guardian"
        },
        "relationship": {
          "type": "string",
          "maxLength": 32,
          "x-code-list": "relationship"
        },
        "has_parental_responsibility": {
          "type": "boolean"
        },
        "contact_priority": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "lives_with": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "is_contact_restricted": {
          "type": "boolean",
          "description": "Detail held in the vault (contact_restriction)"
        },
        "is_authorised_collector": {
          "type": "boolean"
        },
        "is_payer": {
          "type": "boolean"
        },
        "valid_from": {
          "type": "string",
          "format": "date",
          "description": "Effective from (inclusive) — history: effective",
          "readOnly": true
        },
        "valid_to": {
          "type": "string",
          "format": "date",
          "description": "Effective to (inclusive); NULL = open-ended — history: effective",
          "readOnly": true
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time the row was written",
          "readOnly": true
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor: app_user.id or service_identity.id (agents, integrations)",
          "readOnly": true
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time of last change (mutable entities only)",
          "readOnly": true
        },
        "updated_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor of last change (mutable entities only)",
          "readOnly": true
        },
        "row_version": {
          "type": "integer",
          "minimum": 0,
          "description": "Optimistic-lock counter; exposed as the API ETag (mutable entities only)",
          "readOnly": true
        }
      },
      "required": [
        "id",
        "tenant_id",
        "learner_id",
        "guardian_id",
        "relationship",
        "has_parental_responsibility",
        "is_contact_restricted",
        "is_authorised_collector",
        "is_payer",
        "valid_from",
        "created_at",
        "updated_at",
        "row_version"
      ],
      "additionalProperties": false
    },
