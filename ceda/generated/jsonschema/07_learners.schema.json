            },
            {
              "type": "null"
            }
          ]
        },
        "awarded_on": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "credential": {
          "anyOf": [
            {
              "type": "object",
              "description": "Open Badges 3.0 / W3C VC 2.0 document when issued"
            },
            {
              "type": "null"
            }
          ]
        },
        "is_verified": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time the row was written",
          "readOnly": true
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor: app_user.id or service_identity.id (agents, integrations)",
          "readOnly": true
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time of last change (mutable entities only)",
          "readOnly": true
        },
        "updated_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor of last change (mutable entities only)",
          "readOnly": true
        },
        "row_version": {
          "type": "integer",
          "minimum": 0,
          "description": "Optimistic-lock counter; exposed as the API ETag (mutable entities only)",
          "readOnly": true
        }
      },
      "required": [
        "id",
        "tenant_id",
        "learner_id",
        "entry_kind",
        "source_kind",
        "source_id",
        "title",
        "is_verified",
        "created_at",
        "updated_at",
        "row_version"
      ],
      "additionalProperties": false
    },
    "PassportShare": {
      "title": "PassportShare",
      "description": "Consented, time-limited, revocable share of a learner's Education Passport",
      "type": "object",
      "x-ceda": {
        "entity": "passport_share",
        "zone": "registry",
        "domain": "LRN",
        "kind": "transaction",
        "classification": "confidential",
        "history": "lifecycle",
        "module": "learners"
      },
