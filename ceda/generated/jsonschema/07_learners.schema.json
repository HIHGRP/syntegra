                "deceased"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "closed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "in_progress",
            "on_hold",
            "closed",
            "transferred"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time the row was written",
          "readOnly": true
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor: app_user.id or service_identity.id (agents, integrations)",
          "readOnly": true
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time of last change (mutable entities only)",
          "readOnly": true
        },
        "updated_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor of last change (mutable entities only)",
          "readOnly": true
        },
        "row_version": {
          "type": "integer",
          "minimum": 0,
          "description": "Optimistic-lock counter; exposed as the API ETag (mutable entities only)",
          "readOnly": true
        }
      },
      "required": [
        "id",
        "tenant_id",
        "scope_node_id",
        "learner_id",
        "enrolment_id",
        "lga_scope_id",
        "reason",
        "status",
        "created_at",
        "updated_at",
        "row_version"
      ],
      "additionalProperties": false
    },
    "PassportEntry": {
      "title": "PassportEntry",
      "description": "Education Passport entry — qualification, certificate, badge, competency, credit, CPD or digital-skills milestone",
      "type": "object",
      "x-ceda": {
        "entity": "passport_entry",
        "zone": "registry",
        "domain": "LRN",
        "kind": "projection",
        "classification": "confidential",
        "history": "lifecycle",
        "module": "learners"
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Primary key: UUID v7 (time-ordered) stored as BINARY(16) without byte swap",
