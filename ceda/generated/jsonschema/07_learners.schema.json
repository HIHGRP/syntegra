{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.syntegra.io/ceda/v1/07_learners.schema.json",
  "title": "CEDA LRN — Learner 360, state enrolment register, transfer and Education Passport",
  "$defs": {
    "Learner": {
      "title": "Learner",
      "description": "Learner 360 master — one row per person, lifelong",
      "type": "object",
      "x-ceda": {
        "entity": "learner",
        "zone": "registry",
        "domain": "LRN",
        "kind": "master",
        "classification": "confidential",
        "history": "lifecycle",
        "module": "learners"
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Primary key: UUID v7 (time-ordered) stored as BINARY(16) without byte swap",
          "readOnly": true
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning tenant (zones with tenant_column = true)",
          "readOnly": true
        },
        "global_learner_id": {
          "type": "string",
          "pattern": "^LRN-[0-9]{4}-[0-9]{4}-[0-9]{2}$",
          "description": "LRN-NNNN-NNNN-CC, assigned at creation from the state's leased block, never reused"
        },
        "legal_given_name": {
          "type": "string",
          "maxLength": 200,
          "x-personal-data": true
        },
        "legal_middle_names": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200,
              "x-personal-data": true
            },
            {
              "type": "null"
            }
          ]
        },
        "legal_family_name": {
          "type": "string",
          "maxLength": 200,
          "x-personal-data": true
        },
        "preferred_name": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200,
              "x-personal-data": true
            },
            {
              "type": "null"
            }
          ]
        },
        "name_phonetic": {
          "type": "string",
          "maxLength": 120,
          "description": "Double Metaphone keys + Nigerian name-variant keys for blocking"
        },
        "date_of_birth": {
          "type": "string",
          "format": "date",
          "x-personal-data": true
        },
        "dob_precision": {
          "type": "string",
          "enum": [
            "day",
            "month",
            "year"
          ],
          "description": "Displaced and historic learners may have month or year only"
        },
        "sex": {
          "type": "string",
          "maxLength": 32,
          "x-code-list": "sex"
        },
        "nationality": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_of_origin": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "home_languages": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 32
              },
              "x-code-list": "language"
            },
            {
              "type": "null"
            }
          ]
        },
        "photo_document_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "description": "Records zone; restricted",
              "x-classification": "restricted"
            },
            {
              "type": "null"
            }
          ]
        },
        "is_historic": {
          "type": "boolean",
          "description": "Created from a digitised archive (FR-DOC-108)"
        },
        "is_minimal_documentation": {
          "type": "boolean",
          "description": "Temporary enrolment (IDP camps); identity matching reconciles later"
        },
        "identity_verified_level": {
          "type": "string",
          "enum": [
            "unverified",
            "document_seen",
            "nin_verified",
            "archive_verified"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "registered",
            "active",
            "left",
            "deceased",
            "merged"
          ]
        },
        "merged_into": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "x-ref": "learner"
            },
            {
              "type": "null"
            }
          ]
        },
        "deceased_on": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time the row was written",
          "readOnly": true
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor: app_user.id or service_identity.id (agents, integrations)",
          "readOnly": true
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time of last change (mutable entities only)",
          "readOnly": true
        },
        "updated_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor of last change (mutable entities only)",
          "readOnly": true
        },
        "row_version": {
          "type": "integer",
          "minimum": 0,
          "description": "Optimistic-lock counter; exposed as the API ETag (mutable entities only)",
          "readOnly": true
        }
      },
      "required": [
        "id",
        "tenant_id",
        "global_learner_id",
        "legal_given_name",
        "legal_family_name",
        "name_phonetic",
        "date_of_birth",
        "dob_precision",
        "sex",
        "is_historic",
        "is_minimal_documentation",
        "identity_verified_level",
        "status",
        "created_at",
        "updated_at",
        "row_version"
      ],
      "additionalProperties": false
    },
    "Enrolment": {
      "title": "Enrolment",
      "description": "State enrolment register — learner enrolled at an institution (and level, programme) for a period",
      "type": "object",
      "x-ceda": {
        "entity": "enrolment",
        "zone": "registry",
        "domain": "LRN",
        "kind": "transaction",
        "classification": "confidential",
        "history": "lifecycle",
        "module": "learners"
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Primary key: UUID v7 (time-ordered) stored as BINARY(16) without byte swap",
          "readOnly": true
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning tenant (zones with tenant_column = true)",
          "readOnly": true
        },
        "scope_node_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning governance scope node (entities with scope: owned); subtree visibility through scope_closure",
          "readOnly": true
        },
        "learner_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "learner"
        },
        "institution_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "institution"
        },
        "operating_tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Tenant whose ops zone holds the operational record"
        },
        "education_level": {
          "type": "string",
          "maxLength": 32,
          "x-code-list": "education_level"
        },
        "programme_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "x-ref": "programme"
            },
            {
              "type": "null"
            }
          ]
        },
        "class_group_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "x-ref": "class_group",
              "description": "Ops-zone class (arm) for the session"
            },
            {
              "type": "null"
            }
          ]
        },
        "cohort_label": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 60,
              "description": "Intake cohort, e.g. 2026/2027 ND1"
            },
            {
              "type": "null"
            }
          ]
        },
        "is_primary": {
          "type": "boolean"
        },
        "basis": {
          "type": "string",
          "enum": [
            "admission",
            "transfer",
            "promotion",
            "re_enrolment",
            "temporary",
            "repeat"
          ]
        },
        "start_on": {
          "type": "string",
          "format": "date"
        },
        "end_on": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "leaving_reason": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 32,
              "x-code-list": "leaving_reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "destination": {
          "anyOf": [
            {
              "type": "object",
              "description": "Destination institution, employment, unknown …"
            },
            {
              "type": "null"
            }
          ]
        },
        "is_over_capacity_approved": {
          "type": "boolean",
          "description": "Head approval recorded when capacity is exceeded"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "active",
            "completed",
            "withdrawn",
            "transferred",
            "suspended"
          ]
        },
        "active_primary_key": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "description": "= learner_id when status active and is_primary, else NULL (one active primary enrolment)",
              "readOnly": true
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time the row was written",
          "readOnly": true
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor: app_user.id or service_identity.id (agents, integrations)",
          "readOnly": true
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time of last change (mutable entities only)",
          "readOnly": true
        },
        "updated_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor of last change (mutable entities only)",
          "readOnly": true
        },
        "row_version": {
          "type": "integer",
          "minimum": 0,
          "description": "Optimistic-lock counter; exposed as the API ETag (mutable entities only)",
          "readOnly": true
        }
      },
      "required": [
        "id",
        "tenant_id",
        "scope_node_id",
        "learner_id",
        "institution_id",
        "operating_tenant_id",
        "education_level",
        "is_primary",
        "basis",
        "start_on",
        "is_over_capacity_approved",
        "status",
        "created_at",
        "updated_at",
        "row_version"
      ],
      "additionalProperties": false
    },
    "LearnerTransfer": {
      "title": "LearnerTransfer",
      "description": "Transfer of a learner between institutions (within or across tenants and states), with DSL/SENCO handover acknowledgement",
      "type": "object",
      "x-ceda": {
        "entity": "learner_transfer",
        "zone": "registry",
        "domain": "LRN",
        "kind": "transaction",
        "classification": "confidential",
        "history": "lifecycle",
        "module": "learners"
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Primary key: UUID v7 (time-ordered) stored as BINARY(16) without byte swap",
          "readOnly": true
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning tenant (zones with tenant_column = true)",
          "readOnly": true
        },
        "scope_node_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning governance scope node (entities with scope: owned); subtree visibility through scope_closure",
          "readOnly": true
        },
        "learner_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "learner"
        },
        "from_enrolment_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "enrolment"
        },
        "to_institution_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "x-ref": "institution",
              "description": "NULL when leaving the state (exchange)"
            },
            {
              "type": "null"
            }
          ]
        },
        "to_enrolment_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "x-ref": "enrolment"
            },
            {
              "type": "null"
            }
          ]
        },
        "exchange_transfer_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "x-ref": "exchange_transfer",
              "description": "Cross-state or international records exchange"
            },
            {
              "type": "null"
            }
          ]
        },
        "requested_by": {
          "type": "string",
          "format": "uuid",
          "x-ref": "app_user"
        },
        "effective_on": {
          "type": "string",
          "format": "date"
        },
        "records_package": {
          "anyOf": [
            {
              "type": "object",
              "description": "Datasets transferred per policy"
            },
            {
              "type": "null"
            }
          ]
        },
        "dsl_handover_due_on": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "dsl_acknowledged_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "description": "Safeguarding file acknowledged by receiving DSL"
            },
            {
              "type": "null"
            }
          ]
        },
        "senco_acknowledged_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "description": "SEND file acknowledged by receiving SENCO"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "requested",
            "accepted",
            "records_sent",
            "handover_pending",
            "completed",
            "cancelled"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time the row was written",
          "readOnly": true
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor: app_user.id or service_identity.id (agents, integrations)",
          "readOnly": true
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time of last change (mutable entities only)",
          "readOnly": true
        },
        "updated_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor of last change (mutable entities only)",
          "readOnly": true
        },
        "row_version": {
          "type": "integer",
          "minimum": 0,
          "description": "Optimistic-lock counter; exposed as the API ETag (mutable entities only)",
          "readOnly": true
        }
      },
      "required": [
        "id",
        "tenant_id",
        "scope_node_id",
        "learner_id",
        "from_enrolment_id",
        "requested_by",
        "effective_on",
        "status",
        "created_at",
        "updated_at",
        "row_version"
      ],
      "additionalProperties": false
    },
    "CmeReferral": {
      "title": "CmeReferral",
      "description": "Child-missing-education referral to the LGA attendance desk (compulsory-age leaver with unknown destination)",
      "type": "object",
      "x-ceda": {
        "entity": "cme_referral",
        "zone": "registry",
        "domain": "LRN",
        "kind": "transaction",
        "classification": "confidential",
        "history": "lifecycle",
        "module": "learners"
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Primary key: UUID v7 (time-ordered) stored as BINARY(16) without byte swap",
          "readOnly": true
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning tenant (zones with tenant_column = true)",
          "readOnly": true
        },
        "scope_node_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning governance scope node (entities with scope: owned); subtree visibility through scope_closure",
          "readOnly": true
        },
        "learner_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "learner"
        },
        "enrolment_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "enrolment"
        },
        "lga_scope_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "scope_node"
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        },
        "assigned_to": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "x-ref": "app_user"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "located_enrolled",
                "located_not_enrolled",
