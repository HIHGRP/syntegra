{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.syntegra.io/ceda/v1/12_timetable.schema.json",
  "title": "CEDA TIM — Timetable, lesson occurrences, cover rota, duties and room bookings",
  "$defs": {
    "Timetable": {
      "title": "Timetable",
      "description": "Timetable version for an institution and session (one- or two-week cycles, structures per year group)",
      "type": "object",
      "x-ceda": {
        "entity": "timetable",
        "zone": "ops",
        "domain": "TIM",
        "kind": "config",
        "classification": "internal",
        "history": "versioned",
        "module": "timetable"
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Primary key: UUID v7 (time-ordered) stored as BINARY(16) without byte swap",
          "readOnly": true
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning tenant (zones with tenant_column = true)",
          "readOnly": true
        },
        "scope_node_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning governance scope node (entities with scope: owned); subtree visibility through scope_closure",
          "readOnly": true
        },
        "institution_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "institution"
        },
        "period_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "academic_period"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "cycle_weeks": {
          "type": "integer"
        },
        "sessions_per_day": {
          "type": "integer",
          "description": "Double-shift schools"
        },
        "solver_run": {
          "anyOf": [
            {
              "type": "object",
              "description": "Constraint set, objective value and unmet soft constraints"
            },
            {
              "type": "null"
            }
          ]
        },
        "unmet_requirements": {
          "anyOf": [
            {
              "type": "object",
              "description": "Mandatory hours not met (publication blocked unless an exception exists)"
            },
            {
              "type": "null"
            }
          ]
        },
        "exception_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "x-ref": "policy_exception"
            },
            {
              "type": "null"
            }
          ]
        },
        "published_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "approved",
            "published",
            "superseded",
            "retired",
            "withdrawn"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time the row was written",
          "readOnly": true
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor: app_user.id or service_identity.id (agents, integrations)",
          "readOnly": true
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time of last change (mutable entities only)",
          "readOnly": true
        },
        "updated_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor of last change (mutable entities only)",
          "readOnly": true
        },
        "row_version": {
          "type": "integer",
          "minimum": 0,
          "description": "Optimistic-lock counter; exposed as the API ETag (mutable entities only)",
          "readOnly": true
        }
      },
      "required": [
        "id",
        "tenant_id",
        "scope_node_id",
        "institution_id",
        "period_id",
        "version",
        "cycle_weeks",
        "sessions_per_day",
        "status",
        "created_at",
        "updated_at",
        "row_version"
      ],
      "additionalProperties": false
    },
    "PeriodStructure": {
      "title": "PeriodStructure",
      "description": "Bell schedule — named periods with times per day of the cycle and per year-group structure",
      "type": "object",
      "x-ceda": {
        "entity": "period_structure",
        "zone": "ops",
        "domain": "TIM",
        "kind": "config",
        "classification": "internal",
        "history": "none",
        "module": "timetable"
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Primary key: UUID v7 (time-ordered) stored as BINARY(16) without byte swap",
          "readOnly": true
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning tenant (zones with tenant_column = true)",
          "readOnly": true
        },
        "timetable_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "timetable"
        },
        "structure_code": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^[A-Za-z0-9_.:/-]*$",
          "description": "Year-group structure"
        },
        "cycle_day": {
          "type": "integer"
        },
        "period_code": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[A-Za-z0-9_.:/-]*$"
        },
        "starts_at": {
          "type": "string",
          "format": "time"
        },
        "ends_at": {
          "type": "string",
          "format": "time"
        },
        "is_teaching": {
          "type": "boolean",
          "description": "Breaks and registration periods are not teaching"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time the row was written",
          "readOnly": true
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor: app_user.id or service_identity.id (agents, integrations)",
          "readOnly": true
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time of last change (mutable entities only)",
          "readOnly": true
        },
        "updated_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor of last change (mutable entities only)",
          "readOnly": true
        },
        "row_version": {
          "type": "integer",
          "minimum": 0,
          "description": "Optimistic-lock counter; exposed as the API ETag (mutable entities only)",
          "readOnly": true
        }
      },
      "required": [
        "id",
        "tenant_id",
        "timetable_id",
        "structure_code",
        "cycle_day",
        "period_code",
        "starts_at",
        "ends_at",
        "is_teaching",
        "created_at",
        "updated_at",
        "row_version"
      ],
      "additionalProperties": false
    },
    "TimetableLesson": {
      "title": "TimetableLesson",
