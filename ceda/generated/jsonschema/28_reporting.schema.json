    "ReturnSubmission": {
      "title": "ReturnSubmission",
      "description": "Return generated from live data, validated, reviewed, head-certified and submitted (Accepted / Queried)",
      "type": "object",
      "x-ceda": {
        "entity": "return_submission",
        "zone": "registry",
        "domain": "RPT",
        "kind": "transaction",
        "classification": "internal",
        "history": "lifecycle",
        "module": "reporting"
      },
      "properties": {
