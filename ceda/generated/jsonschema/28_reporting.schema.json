          "format": "uuid",
          "description": "Owning tenant (zones with tenant_column = true)",
          "readOnly": true
        },
        "scope_node_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning governance scope node (entities with scope: owned); subtree visibility through scope_closure",
          "readOnly": true
        },
        "report_definition_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "report_definition"
        },
        "cron": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.:/-]*$"
        },
        "recipients": {
          "type": "object"
        },
        "format": {
          "type": "string",
          "enum": [
            "xlsx",
            "csv",
            "pdf",
            "json"
          ]
        },
        "last_run_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "inactive",
            "retired"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time the row was written",
          "readOnly": true
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor: app_user.id or service_identity.id (agents, integrations)",
          "readOnly": true
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time of last change (mutable entities only)",
          "readOnly": true
        },
        "updated_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor of last change (mutable entities only)",
          "readOnly": true
        },
        "row_version": {
          "type": "integer",
          "minimum": 0,
          "description": "Optimistic-lock counter; exposed as the API ETag (mutable entities only)",
          "readOnly": true
        }
      },
      "required": [
        "id",
        "tenant_id",
        "scope_node_id",
        "report_definition_id",
        "cron",
        "recipients",
        "format",
        "status",
        "created_at",
        "updated_at",
        "row_version"
      ],
      "additionalProperties": false
    },
    "ReportExport": {
      "title": "ReportExport",
      "description": "Export of a permitted table, chart or report (Excel/CSV/PDF), logged; bulk exports of confidential data audited",
      "type": "object",
      "x-ceda": {
        "entity": "report_export",
        "zone": "ops",
        "domain": "RPT",
        "kind": "event",
        "classification": "internal",
        "history": "append",
        "module": "reporting"
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Primary key: UUID v7 (time-ordered) stored as BINARY(16) without byte swap",
          "readOnly": true
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning tenant (zones with tenant_column = true)",
          "readOnly": true
        },
        "requested_by": {
          "type": "string",
          "format": "uuid"
        },
        "source": {
          "type": "string",
          "maxLength": 200,
          "description": "Page region, report code or BI connector"
        },
        "format": {
          "type": "string",
          "enum": [
            "xlsx",
            "csv",
            "pdf",
            "json"
          ]
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "object_key": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1024,
              "description": "Expiring export object"
            },
            {
              "type": "null"
            }
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time the row was written",
          "readOnly": true
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor: app_user.id or service_identity.id (agents, integrations)",
          "readOnly": true
        }
      },
      "required": [
        "id",
        "tenant_id",
        "requested_by",
        "source",
        "format",
        "row_count",
        "expires_at",
        "created_at"
      ],
      "additionalProperties": false
    },
