{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.syntegra.io/ceda/v1/37_estate.schema.json",
  "title": "CEDA EST — Government property register, facility condition and usability, preventive maintenance and proactive actions",
  "$defs": {
    "PropertySite": {
      "title": "PropertySite",
      "description": "Government property site (land) used by an institution — owner, title, area, boundary, fencing, encroachment, valuation",
      "type": "object",
      "x-ceda": {
        "entity": "property_site",
        "zone": "ops",
        "domain": "EST",
        "kind": "master",
        "classification": "internal",
        "history": "lifecycle",
        "module": "estate"
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Primary key: UUID v7 (time-ordered) stored as BINARY(16) without byte swap",
          "readOnly": true
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning tenant (zones with tenant_column = true)",
          "readOnly": true
        },
        "scope_node_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning governance scope node (entities with scope: owned); subtree visibility through scope_closure",
          "readOnly": true
        },
        "site_code": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9_.:/-]*$"
        },
        "name": {
          "type": "string",
          "maxLength": 300
        },
        "institution_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "institution"
        },
        "campus_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "x-ref": "campus"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner": {
          "type": "string",
          "enum": [
            "federal_government",
            "state_government",
            "local_government",
            "community",
            "mission_or_faith",
            "private",
            "leased"
          ]
        },
        "title_document": {
          "type": "string",
          "enum": [
            "certificate_of_occupancy",
            "right_of_occupancy",
            "gazette",
            "deed_of_assignment",
            "deed_of_gift",
            "survey_plan_only",
            "customary",
            "lease",
            "none_or_unknown"
          ]
        },
        "title_reference": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_.:/-]*$",
              "description": "C of O, gazette or survey plan number"
            },
            {
              "type": "null"
            }
          ]
        },
        "area_sqm": {
          "anyOf": [
            {
              "type": "string",
              "format": "decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "anyOf": [
            {
              "type": "object",
              "x-geojson": "Point"
            },
            {
              "type": "null"
            }
          ]
        },
        "boundary": {
          "anyOf": [
            {
              "type": "object",
              "description": "GeoJSON polygon of the surveyed boundary"
            },
            {
              "type": "null"
            }
          ]
        },
        "fenced": {
          "type": "string",
          "enum": [
            "fully_fenced",
            "partly_fenced",
            "not_fenced",
            "unknown"
          ]
        },
        "encroachment": {
          "type": "string",
          "enum": [
            "none",
            "suspected",
            "confirmed",
            "in_dispute",
            "resolved",
            "unknown"
          ]
        },
        "acquired_on": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "valuation_minor": {
          "anyOf": [
            {
              "type": "integer",
              "description": "(minor units)"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "valued_on": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "data_status": {
          "type": "string",
          "enum": [
            "verified",
            "illustrative",
            "to_confirm"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "inactive",
            "retired"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time the row was written",
          "readOnly": true
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor: app_user.id or service_identity.id (agents, integrations)",
          "readOnly": true
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time of last change (mutable entities only)",
          "readOnly": true
        },
        "updated_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor of last change (mutable entities only)",
          "readOnly": true
        },
        "row_version": {
          "type": "integer",
          "minimum": 0,
          "description": "Optimistic-lock counter; exposed as the API ETag (mutable entities only)",
          "readOnly": true
        }
      },
      "required": [
        "id",
        "tenant_id",
        "scope_node_id",
        "site_code",
        "name",
        "institution_id",
        "owner",
        "title_document",
        "fenced",
        "encroachment",
        "data_status",
        "status",
        "created_at",
        "updated_at",
        "row_version"
      ],
      "additionalProperties": false
    },
    "FacilityAssessment": {
      "title": "FacilityAssessment",
      "description": "Dated condition and usability assessment of a site, building, room or item of equipment",
      "type": "object",
      "x-ceda": {
        "entity": "facility_assessment",
        "zone": "ops",
        "domain": "EST",
        "kind": "event",
        "classification": "internal",
        "history": "append",
        "module": "estate"
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Primary key: UUID v7 (time-ordered) stored as BINARY(16) without byte swap",
          "readOnly": true
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning tenant (zones with tenant_column = true)",
          "readOnly": true
        },
        "scope_node_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning governance scope node (entities with scope: owned); subtree visibility through scope_closure",
          "readOnly": true
        },
        "institution_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "institution"
        },
        "subject_kind": {
          "type": "string",
          "enum": [
            "site",
            "building",
            "room",
            "asset"
          ]
        },
        "subject_id": {
          "type": "string",
          "format": "uuid"
        },
        "assessed_on": {
          "type": "string",
          "format": "date"
        },
        "assessor_kind": {
          "type": "string",
          "enum": [
            "head_of_institution",
            "estate_officer",
            "engineer",
            "quality_inspector",
            "lga_officer",
            "contractor",
            "community"
          ]
        },
        "assessed_by": {
          "type": "string",
          "format": "uuid"
        },
        "condition_grade": {
          "type": "string",
          "maxLength": 32,
          "x-code-list": "condition_grade"
        },
        "usability": {
          "type": "string",
          "enum": [
            "fully_usable",
            "usable_minor_repairs",
            "usable_major_repairs",
            "unsafe_restricted",
            "unusable",
            "condemned"
          ]
        },
        "structural_risk": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "moderate",
            "info"
          ]
        },
        "defects": {
          "anyOf": [
            {
              "type": "object",
              "description": "Element (roof, walls, floor, doors, windows, wiring, plumbing …), defect and severity"
            },
            {
              "type": "null"
            }
          ]
        },
        "utilities": {
          "anyOf": [
            {
              "type": "object",
              "description": "Water, power, sanitation and internet working at the time"
            },
            {
              "type": "null"
            }
          ]
        },
        "in_use": {
          "type": "boolean",
          "description": "Whether the facility is being used at the time of assessment"
        },
        "learners_affected": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "repair_estimate_minor": {
          "anyOf": [
            {
              "type": "integer",
              "description": "(minor units)"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "photo_document_ids": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_due_on": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "description": "When it should be assessed again"
            },
            {
              "type": "null"
            }
          ]
        },
        "client_op_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "description": "Offline capture (idempotent)"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time the row was written",
          "readOnly": true
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor: app_user.id or service_identity.id (agents, integrations)",
          "readOnly": true
        }
      },
      "required": [
        "id",
        "tenant_id",
        "scope_node_id",
        "institution_id",
        "subject_kind",
        "subject_id",
        "assessed_on",
        "assessor_kind",
        "assessed_by",
        "condition_grade",
        "usability",
        "structural_risk",
        "in_use",
        "created_at"
      ],
      "additionalProperties": false
    },
    "MaintenanceSchedule": {
      "title": "MaintenanceSchedule",
      "description": "Planned preventive maintenance task for a site, building, room or item of equipment (frequency, next due, responsible person)",
      "type": "object",
      "x-ceda": {
        "entity": "maintenance_schedule",
        "zone": "ops",
        "domain": "EST",
        "kind": "config",
        "classification": "internal",
        "history": "lifecycle",
        "module": "estate"
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Primary key: UUID v7 (time-ordered) stored as BINARY(16) without byte swap",
          "readOnly": true
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning tenant (zones with tenant_column = true)",
          "readOnly": true
        },
        "scope_node_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning governance scope node (entities with scope: owned); subtree visibility through scope_closure",
          "readOnly": true
        },
        "institution_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "institution"
        },
        "subject_kind": {
          "type": "string",
          "enum": [
            "site",
            "building",
            "room",
            "asset"
          ]
        },
        "subject_id": {
          "type": "string",
          "format": "uuid"
        },
        "task": {
          "type": "string",
          "maxLength": 200
        },
        "task_kind": {
          "type": "string",
          "enum": [
            "inspection",
            "servicing",
            "statutory_test",
            "cleaning",
            "pest_control",
            "roofing",
            "plumbing",
            "electrical",
            "painting",
            "generator_service",
            "solar_service",
            "borehole_service",
            "fire_safety",
            "replacement",
            "other"
          ]
        },
        "frequency_days": {
          "type": "integer"
        },
        "last_done_on": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_due_on": {
          "type": "string",
          "format": "date"
        },
        "responsible_staff_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "x-ref": "staff"
            },
            {
              "type": "null"
            }
          ]
        },
        "estimated_cost_minor": {
          "anyOf": [
            {
              "type": "integer",
              "description": "(minor units)"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "inactive",
            "retired"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time the row was written",
          "readOnly": true
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor: app_user.id or service_identity.id (agents, integrations)",
          "readOnly": true
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time of last change (mutable entities only)",
          "readOnly": true
        },
        "updated_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor of last change (mutable entities only)",
          "readOnly": true
        },
        "row_version": {
          "type": "integer",
          "minimum": 0,
          "description": "Optimistic-lock counter; exposed as the API ETag (mutable entities only)",
          "readOnly": true
        }
      },
      "required": [
        "id",
        "tenant_id",
        "scope_node_id",
        "institution_id",
        "subject_kind",
        "subject_id",
        "task",
        "task_kind",
        "frequency_days",
        "next_due_on",
        "status",
        "created_at",
        "updated_at",
        "row_version"
      ],
      "additionalProperties": false
    },
    "FacilityAction": {
      "title": "FacilityAction",
      "description": "Proactive action proposed to the head of institution, with owner, due date and escalation to the LGA and ministry",
      "type": "object",
      "x-ceda": {
        "entity": "facility_action",
        "zone": "ops",
        "domain": "EST",
        "kind": "transaction",
        "classification": "internal",
        "history": "lifecycle",
        "module": "estate"
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Primary key: UUID v7 (time-ordered) stored as BINARY(16) without byte swap",
          "readOnly": true
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning tenant (zones with tenant_column = true)",
          "readOnly": true
        },
        "scope_node_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning governance scope node (entities with scope: owned); subtree visibility through scope_closure",
          "readOnly": true
        },
        "institution_id": {
          "type": "string",
          "format": "uuid",
          "x-ref": "institution"
        },
        "rule": {
          "type": "string",
          "enum": [
            "unsafe_in_use",
            "assessment_overdue",
            "never_assessed",
            "maintenance_due",
            "maintenance_overdue",
            "condition_deteriorated",
            "safety_check_overdue",
            "predicted_failure",
            "encroachment",
            "no_title"
          ]
        },
        "subject_kind": {
          "type": "string",
          "enum": [
            "site",
            "building",
            "room",
            "asset"
          ]
        },
        "subject_id": {
          "type": "string",
          "format": "uuid"
        },
        "dedupe_key": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9_.:/-]*$",
          "description": "rule:subject while open; suffixed with the action id when closed"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "detail": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 65535
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "moderate",
            "info"
          ]
        },
        "owner_role": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[A-Za-z0-9_.:/-]*$"
        },
        "due_on": {
          "type": "string",
          "format": "date"
        },
        "escalation_level": {
          "type": "integer",
          "description": "0 institution, 1 LGA, 2 ministry"
        },
        "escalated_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "maintenance_request_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "x-ref": "maintenance_request"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolved_by": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolved_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 65535
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "acknowledged",
            "in_progress",
            "done",
            "dismissed"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time the row was written",
          "readOnly": true
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor: app_user.id or service_identity.id (agents, integrations)",
          "readOnly": true
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time of last change (mutable entities only)",
          "readOnly": true
        },
        "updated_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor of last change (mutable entities only)",
          "readOnly": true
        },
        "row_version": {
          "type": "integer",
          "minimum": 0,
          "description": "Optimistic-lock counter; exposed as the API ETag (mutable entities only)",
          "readOnly": true
        }
      },
      "required": [
        "id",
        "tenant_id",
        "scope_node_id",
        "institution_id",
        "rule",
        "subject_kind",
        "subject_id",
        "dedupe_key",
        "title",
        "priority",
        "owner_role",
        "due_on",
        "escalation_level",
        "status",
        "created_at",
        "updated_at",
        "row_version"
      ],
      "additionalProperties": false
    }
  }
}
