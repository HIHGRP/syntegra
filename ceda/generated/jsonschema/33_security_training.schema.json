        "data_status": {
          "type": "string",
          "enum": [
            "verified",
            "illustrative",
            "to_confirm"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "inactive",
            "retired"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time the row was written",
          "readOnly": true
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor: app_user.id or service_identity.id (agents, integrations)",
          "readOnly": true
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time of last change (mutable entities only)",
          "readOnly": true
        },
        "updated_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor of last change (mutable entities only)",
          "readOnly": true
        },
        "row_version": {
          "type": "integer",
          "minimum": 0,
          "description": "Optimistic-lock counter; exposed as the API ETag (mutable entities only)",
          "readOnly": true
        }
      },
      "required": [
        "id",
        "tenant_id",
        "scope_node_id",
        "agency_id",
        "unit_type",
        "code",
        "name",
        "data_status",
        "status",
        "created_at",
        "updated_at",
        "row_version"
      ],
      "additionalProperties": false
    },
