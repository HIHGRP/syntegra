            "formation",
            "zone",
            "state_command",
            "area_command",
            "sector_command"
          ]
        },
        "code": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[A-Za-z0-9_.:/-]*$",
          "description": "Unique within the agency, e.g. TRADOC, NAVTRAC, ATC, LA-CMD"
        },
        "name": {
          "type": "string",
          "maxLength": 300
        },
        "headquarters_state": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$",
