{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.syntegra.io/ceda/v1/33_security_training.schema.json",
  "title": "CEDA STI — Education and training institutions of the security agencies — agency structures, ranks, courses, intakes",
  "$defs": {
    "SecurityAgency": {
      "title": "SecurityAgency",
      "description": "Security agency (armed service, police, paramilitary, law-enforcement, emergency or security service)",
      "type": "object",
      "x-ceda": {
        "entity": "security_agency",
        "zone": "registry",
        "domain": "STI",
        "kind": "master",
        "classification": "internal",
        "history": "lifecycle",
        "module": "security_training"
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Primary key: UUID v7 (time-ordered) stored as BINARY(16) without byte swap",
          "readOnly": true
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning tenant (zones with tenant_column = true)",
          "readOnly": true
        },
        "scope_node_id": {
          "type": "string",
          "format": "uuid",
          "description": "Owning governance scope node (entities with scope: owned); subtree visibility through scope_closure",
          "readOnly": true
        },
        "code": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[A-Za-z0-9_.:/-]*$",
          "description": "e.g. NA, NN, NAF, DHQ, NPF, NSCDC, NCoS, NIS, NCS, FFS, FRSC, NDLEA, DSS, EFCC"
        },
        "name": {
          "type": "string",
          "maxLength": 300
        },
        "category": {
          "type": "string",
          "enum": [
            "armed_forces",
            "police",
            "paramilitary",
            "law_enforcement",
            "intelligence_security",
            "emergency_service"
          ]
        },
        "supervising_ministry": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200,
              "description": "Ministry or office the agency reports to"
            },
            {
              "type": "null"
            }
          ]
        },
        "establishing_law": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 300,
              "description": "Act establishing the agency"
            },
            {
              "type": "null"
            }
          ]
        },
        "website": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "data_status": {
          "type": "string",
          "enum": [
            "verified",
            "illustrative",
            "to_confirm"
          ],
          "description": "verified by the agency, illustrative, or to be confirmed"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "inactive",
            "retired"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time the row was written",
          "readOnly": true
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor: app_user.id or service_identity.id (agents, integrations)",
          "readOnly": true
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time of last change (mutable entities only)",
          "readOnly": true
        },
        "updated_by": {
          "type": "string",
          "format": "uuid",
          "description": "Actor of last change (mutable entities only)",
          "readOnly": true
        },
        "row_version": {
          "type": "integer",
          "minimum": 0,
          "description": "Optimistic-lock counter; exposed as the API ETag (mutable entities only)",
          "readOnly": true
        }
      },
      "required": [
        "id",
        "tenant_id",
        "scope_node_id",
        "code",
        "name",
        "category",
        "data_status",
        "status",
        "created_at",
        "updated_at",
        "row_version"
      ],
      "additionalProperties": false
    },
    "AgencyUnit": {
      "title": "AgencyUnit",
